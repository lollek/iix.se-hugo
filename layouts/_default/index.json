{{- $.Scratch.Add "index" slice -}}
{{- range .Site.RegularPages -}}
    {{- if and (not .Params.searchHidden) (ne .Layout `archives`) }}
    {{- $content := .Plain -}}
    {{- if eq .Layout "coffee" -}}
        {{- range hugo.Data.coffee_beans -}}
            {{- $content = printf "%s %s %s %s %s %s" $content .rating .bean .brand .cost .comment -}}
        {{- end -}}
    {{- end -}}
    {{- $.Scratch.Add "index" (dict "title" .Title "content" $content "permalink" .Permalink "summary" .Summary "html" (partial "list_item.html" .)) -}}
    {{- end }}
{{- end -}}
{{- $.Scratch.Get "index" | jsonify -}}
